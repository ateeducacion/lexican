{
  "name": "lexican",
  "version": "2.0.0-dev",
  "private": true,
  "description": "LexiCán: diccionarios personales y de aula para el aprendizaje del léxico",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @lexican/web",
    "dev:demo": "npm run dev:demo --workspace @lexican/web",
    "dev:api": "npm run dev --workspace @lexican/api",
    "build": "npm run build --workspace @lexican/web && npm run build --workspace @lexican/api",
    "build:demo": "npm run build:demo --workspace @lexican/web",
    "preview:demo": "npm run preview:demo --workspace @lexican/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "vitest run packages/app",
    "test:integration": "vitest run apps/api",
    "test:migration": "vitest run tools",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --project='demo-*'",
    "e2e:webkit": "playwright test --project=demo-webkit --workers=1",
    "db:generate": "npm run generate --workspace @lexican/db",
    "db:migrate": "npm run db:migrate --workspace @lexican/api",
    "db:seed": "npm run db:seed --workspace @lexican/api",
    "migrate:legacy": "npm run migrate:legacy --workspace @lexican/legacy-migrator --",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "licenses": "node scripts/licenses.mjs",
    "sbom": "npm sbom --sbom-format spdx --omit dev > sbom.spdx.json",
    "metrics": "node scripts/metrics.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
