{
  "name": "lexican",
  "version": "2.0.0-dev",
  "private": true,
  "description": "LexiCán: diccionarios personales y de aula para el aprendizaje del léxico",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run --filter @lexican/web dev",
    "dev:demo": "bun run --filter @lexican/web dev:demo",
    "dev:api": "bun run --filter @lexican/api dev",
    "fake-cas": "bun scripts/fake-cas-server.mjs 4318",
    "build": "bun run --filter @lexican/web build && bun run --filter @lexican/api build",
    "build:demo": "bun run --filter @lexican/web build:demo",
    "preview:demo": "bun scripts/static-pages-server.mjs 4317",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "vitest run packages/app",
    "test:integration": "vitest run apps/api",
    "test:migration": "vitest run tools",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --project='demo-*'",
    "e2e:webkit": "playwright test --project=demo-webkit --workers=1",
    "db:generate": "bun run --filter @lexican/db generate",
    "db:migrate": "bun run --filter @lexican/api db:migrate",
    "db:seed": "bun run --filter @lexican/api db:seed",
    "migrate:legacy": "bun --no-env-file tools/legacy-migrator/src/cli.ts",
    "check:dist": "bun scripts/check-dist.mjs",
    "check": "bun run lint && bun run typecheck && bun run test",
    "audit": "bun audit --audit-level=high",
    "licenses": "bun scripts/licenses.mjs",
    "sbom": "bun scripts/sbom.mjs",
    "metrics": "bun scripts/metrics.mjs",
    "og-image": "bun run build:demo && bun scripts/make-og-image.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/bun": "1.4.2",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "typescript": "~6.0",
    "vitest": "^5.0.3"
  }
}
