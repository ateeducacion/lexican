# LexiCán API configuration. Copy to apps/api/.env (never commit it). Placeholder values only.
# `bun run dev:api` / `db:migrate` / `db:seed` load this file explicitly (Bun never loads .env files implicitly).

# Deployment profile: production (default; institutional CAS + CAUCE only), local (test CAS, fictitious profiles,
# demo data) or test. Decided only here, never from the hostname or NODE_ENV.
APP_ENV=local

DATABASE_URL=postgres://lexican:lexican@localhost:5432/lexican
PORT=3000
# Public origin users see. Used for the CAS service URL, the Origin (CSRF) allowlist and cookie security:
# https → cookie "__Host-sid" (Secure); http → cookie "sid". With the Vite dev server use http://localhost:5173.
PUBLIC_URL=http://localhost:5173
SESSION_TTL_HOURS=8
MEDIA_DIR=./data/media
MAX_UPLOAD_MB=10
# Per-user upload quota over a rolling 24 h window.
MEDIA_QUOTA_MB_PER_DAY=100
# School year start (MM-DD).
SCHOOL_YEAR_START=08-30
LOG_LEVEL=info
# Serve the built SPA from this directory (production image sets it).
WEB_DIST=
# Behind a reverse proxy: number of trusted hops (e.g. 1) or a comma list of proxy IPs/CIDRs. "true" is refused.
TRUST_PROXY=
# Apply migrations at startup (otherwise: bun run --filter @lexican/api db:migrate).
MIGRATE_ON_START=false

# Password login with seeded accounts: APP_ENV=local or test only (refused in production).
AUTH_DEV_LOGIN=true

# CAS 3.0 server (with its path prefix, no query). APP_ENV=local defaults to the public TEST CAS below, whose
# documented accounts are alice/pwd and bob/pwd. Never type institutional credentials there. Production requires the
# institutional server (https) and refuses this one.
CAS_URL=https://www.casserverpac4j.dev
CAS_LOGIN_PATH=/login
CAS_VALIDATE_PATH=/p3/serviceValidate
CAS_LOGOUT_PATH=/logout
# Who resolves a validated CAS subject: `test` (fictitious profiles, no CAUCE) or `cauce` (institutional directory,
# requires CAUCE_URL and CAUCE_TOKEN; the only value allowed in production).
CAS_PROFILES=test
# Comma list of IP addresses allowed to POST back-channel single logout. Required in production when CAS is enabled.
# The CAS service registry must accept PUBLIC_URL/api/auth/cas/callback?state=… (prefix/pattern match).
CAS_ALLOWED_SLO_HOSTS=
# Directory endpoint; the CAS user id is appended URL-encoded. Example shape only.
CAUCE_URL=
CAUCE_TOKEN=

# Password-login attempts per minute and IP (dev/test provider only)
# LOGIN_RATE_LIMIT=10
