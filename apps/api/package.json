    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@lexican/app": "*",
    "@lexican/core": "*",
    "@lexican/db": "*",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
