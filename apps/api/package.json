{
  "name": "@lexican/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file --env-file=.env --watch src/server.ts",
    "build": "rm -rf dist && bun build src/server.ts src/cli/migrate.ts src/cli/seed.ts --root src --target bun --outdir dist --sourcemap=linked && cp -R ../../packages/db/migrations dist/migrations",
    "start": "bun --no-env-file dist/server.js",
    "db:migrate": "bun --no-env-file --env-file=.env src/cli/migrate.ts",
    "db:seed": "bun --no-env-file --env-file=.env src/cli/seed.ts"
  },
  "dependencies": {
    "@lexican/app": "*",
    "@lexican/core": "*",
    "@lexican/db": "*",
    "@lexican/http": "*",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/proxy-addr": "^2.0.3"
  }
}
